{
  "name": "vistegra/vms-nc-api",
  "description": "Universal Multi-Tenant Catalog Integration src/Engine for VMS / Nicole Core",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=7.2",
    "slim/slim": "4.8.1",
    "slim/psr7": "1.3.0",
    "php-di/php-di": "6.3.5",
    "monolog/monolog": "^2.9",
    "firebase/php-jwt": "^6.0",
    "guzzlehttp/guzzle": "^7.3",
    "symfony/polyfill-php80": "^1.28"
  },
  "autoload": {
    "psr-4": {
      "VmsNcApi\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "platform-check": false,
    "audit": {
      "block-insecure": false
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}